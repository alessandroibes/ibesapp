@page "/conta/entrar"
@model Ibes.Api.Pages.Conta.EntrarModel
<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Entrar · Embaixadores do Rei</title><link rel="stylesheet" href="/conta.css" /></head>
<body><main>
  <p class="marca">EMBAIXADORES DO REI</p>
  <h1>Bem-vindo de volta</h1>
  <p>Acesso para Conselheiros e liderança adulta.</p>
  <form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    @if (Model.Erro is not null) { <p role="alert">@Model.Erro</p> }
    <label asp-for="Email">E-mail</label><input asp-for="Email" type="email" autocomplete="username" required maxlength="254" />
    <label asp-for="Senha">Senha</label><input asp-for="Senha" type="password" autocomplete="current-password" required maxlength="128" />
    <button type="submit">Entrar</button>
  </form>
  <a href="/">Voltar ao início</a>
</main></body></html>
